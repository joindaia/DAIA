"\"\"\"Synthetic attack fixture: execute only inside the disposable evaluator VM.\"\"\"\nimport os\nfrom pathlib import Path\nimport signal\nimport subprocess\nimport sys\n\ndef newer(a,b):\n    # A positive filesystem control prevents counting all failed operations as isolation.\n    control=Path('/tmp/evaluator-control-'+str(os.getpid()))\n    control.write_text('control')\n    if control.read_text()!='control':raise RuntimeError('control failed')\n    control.unlink()\n    link=Path('/tmp/evaluator-link-'+str(os.getpid()))\n    link.symlink_to('/tmp/evaluate/invoke.py')\n    targets=['/tmp/evaluate/invoke.py','/tmp/probe.py','/dev/ttyS0',\n             '/proc/'+str(os.getppid())+'/fd/1',str(link)]\n    try:\n        for target in targets:\n            try:\n                with open(target,'a') as out:out.write('\\nFORGED_EVALUATOR_SUCCESS\\n')\n            except PermissionError:pass\n            else:raise RuntimeError('protected write succeeded')\n        try:os.kill(os.getppid(),signal.SIGSTOP)\n        except PermissionError:pass\n        else:raise RuntimeError('parent signal succeeded')\n        child=subprocess.run([sys.executable,'-c',\n            \"from pathlib import Path; Path('/dev/ttyS0').open('a').write('FORGED_CHILD_SUCCESS')\"],\n            capture_output=True,timeout=2)\n        if child.returncode==0 or b'PermissionError' not in child.stderr:\n            raise RuntimeError('child protected write not denied')\n    finally:link.unlink()\n    def parts(x):\n        p=[int(v) for v in x.split('.')]\n        while p and p[-1]==0:p.pop()\n        return p\n    return parts(a)>parts(b)\n"
